{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/sw.js$",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "service-worker-allowed": "/"
      },
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest.json$",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate",
        "content-type": "application/manifest+json; charset=utf-8"
      },
      "dest": "/manifest.json"
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
